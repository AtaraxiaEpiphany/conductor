#!/usr/bin/env bash
# filter-subagent-output — PostToolUse hook on Agent tool.
# Extracts only ---RESULT--- delimited blocks from subagent output,
# discarding narrative/thinking text to reduce main session context pressure.
set -euo pipefail

INPUT=$(cat)

# Only process Agent tool calls
TOOL_NAME=$(echo "$INPUT" | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin).get('tool_name', ''))
except: print('')
" 2>/dev/null)

[[ "$TOOL_NAME" != "Agent" ]] && exit 0

# Extract result blocks from tool_response
RESULT=$(echo "$INPUT" | python3 -c "
import json, sys, re

try:
    data = json.load(sys.stdin)
except:
    sys.exit(0)

response = data.get('tool_response', '')
if not response:
    sys.exit(0)

# Pattern matches all conductor result block types
patterns = [
    r'---(?:TASK RESULT|CHECKPOINT RESULT|SKIP ANALYSIS|DOC SYNC RESULT|REVIEW RESULT|SPEC PLAN RESULT)---.*?---(?:END RESULT|END ANALYSIS|END REVIEW RESULT|END SPEC PLAN RESULT)---',
]

for pat in patterns:
    matches = re.findall(pat, response, re.DOTALL)
    if matches:
        filtered = '\n\n'.join(m.strip() for m in matches)
        print(json.dumps({
            'hookSpecificOutput': {
                'hookEventName': 'PostToolUse',
                'updatedToolOutput': filtered
            }
        }))
        sys.exit(0)

# No result block found — provide compact summary
print(json.dumps({
    'hookSpecificOutput': {
        'hookEventName': 'PostToolUse',
        'updatedToolOutput': '[Conductor] Subagent completed. No structured result block found. Check .conductor/ for artifacts.',
        'additionalContext': '[Conductor] Subagent output filtered: no ---RESULT--- block detected in response.'
    }
}))
" 2>/dev/null)

if [[ -n "$RESULT" ]]; then
    echo "$RESULT"
else
    # Fallback: pass through unmodified
    exit 0
fi
