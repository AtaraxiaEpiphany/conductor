#!/usr/bin/env bash
# ConfigChange hook: validate and log hook configuration changes.
# Monitors hooks.json modifications for safety.
set -euo pipefail

INPUT=$(cat)

SOURCE=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('source',''))" 2>/dev/null || echo "")
FILE_PATH=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('file_path',''))" 2>/dev/null || echo "")

DATA_DIR="${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/.data}"
LOG_DIR="${DATA_DIR}/logs"
mkdir -p "$LOG_DIR"

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
SESSION_ID=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('session_id',''))" 2>/dev/null || echo "")

# Log config change
echo "${TIMESTAMP} session=${SESSION_ID} source=${SOURCE} file=${FILE_PATH} event=config_change" >> "${LOG_DIR}/config-changes.log"

# Validate hooks.json changes
if [[ "$FILE_PATH" == *"hooks"* ]] || [[ "$FILE_PATH" == *"settings"* ]]; then
    # Check for potentially dangerous hook modifications
    ISSUES=$(python3 -c "
import json, os

dangerous_patterns = [
    'rm -rf',
    'curl.*\|.*sh',
    'eval \$',
    '; rm ',
    '> /etc/',
    'mv /usr/',
]

try:
    # Try to read the modified file
    with open('${FILE_PATH}') as f:
        content = f.read()

    issues = []
    for pattern in dangerous_patterns:
        if pattern.lower() in content.lower():
            issues.append(pattern)

    if issues:
        print('DANGEROUS_HOOKS:' + ','.join(issues))
    else:
        print('OK')
except Exception as e:
    print('READ_ERROR:' + str(e))
" 2>/dev/null || echo "READ_ERROR")

    if [[ "$ISSUES" != "OK" ]]; then
        if [[ "$ISSUES" == DANGEROUS_HOOKS:* ]]; then
            DANGEROUS=$(echo "$ISSUES" | sed 's/DANGEROUS_HOOKS://')
            python3 -c "
import json, sys
print(json.dumps({
    'hookSpecificOutput': {
        'hookEventName': 'ConfigChange',
        'additionalContext': '[Conductor] WARNING: Hook configuration contains suspicious patterns: ${DANGEROUS}. Review before trusting.'
    }
}))
"
        fi
    fi
fi

echo '{}'
exit 0