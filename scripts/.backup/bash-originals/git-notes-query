#!/usr/bin/env bash
# git-notes-query: Query and display Conductor git notes audit data.
# Usage:
#   git-notes-query --sha <commit-hash>          Show notes for specific commit
#   git-notes-query --track <track-id>           Show all notes for a track
#   git-notes-query --session <session-id>       Show all notes for a session
#   git-notes-query --coverage-trend             Show test coverage trend
#   git-notes-query --files                      Show all changed files
#   git-notes-query --deviations                 Show spec deviations
set -euo pipefail

query_type=""
arg_value=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --sha) query_type="sha"; arg_value="$2"; shift 2 ;;
    --track) query_type="track"; arg_value="$2"; shift 2 ;;
    --session) query_type="session"; arg_value="$2"; shift 2 ;;
    --coverage-trend) query_type="coverage_trend"; shift ;;
    --files) query_type="files"; shift ;;
    --deviations) query_type="deviations"; shift ;;
    --help) echo "Usage: $0 [--sha SHA|--track ID|--session ID|--coverage-trend|--files|--deviations]"; exit 0 ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# Helper function to parse note JSON
parse_note() {
  local note="$1"
  echo "$note" | jq '.' 2>/dev/null || echo "$note"
}

# Collect all notes with conductor data
get_all_notes() {
  for ref in $(git notes list | awk '{print $2}'); do
    local note=$(git notes show "$ref" 2>/dev/null || echo "")
    if echo "$note" | jq -e '.conductor' >/dev/null 2>&1; then
      echo "$note" | jq -c --arg ref "$ref" '. + {commit_ref: $ref}'
    fi
  done
}

case "$query_type" in
  sha)
    if [[ -z "$arg_value" ]]; then
      echo "Error: --sha requires a commit hash"
      exit 1
    fi
    git notes show "$arg_value" 2>/dev/null | jq '.' || echo "No notes found for $arg_value"
    ;;

  track)
    if [[ -z "$arg_value" ]]; then
      echo "Error: --track requires a track ID"
      exit 1
    fi
    get_all_notes | jq -r "select(.conductor.track_id == \"$arg_value\")"
    ;;

  session)
    if [[ -z "$arg_value" ]]; then
      echo "Error: --session requires a session ID"
      exit 1
    fi
    get_all_notes | jq -r "select(.conductor.session_id == \"$arg_value\")"
    ;;

  coverage_trend)
    echo "# Test Coverage Trend"
    get_all_notes | jq -r '[.conductor.timestamp, .requirements.tc_implemented | length] | @tsv' | \
      awk 'BEGIN {print "Timestamp\tTC Count"} {print}'
    ;;

  files)
    echo "# All Changed Files by Track"
    get_all_notes | jq -r '"\(.conductor.track_id)\t\(.implementation.files_added // [] | join(","))\t\(.implementation.files_modified // [] | join(","))"'
    ;;

  deviations)
    echo "# Specification Deviations"
    get_all_notes | jq -r 'select(.requirements.spec_deviation != "NONE") |
      "\(.conductor.track_id) \(.task.phase).\(.task.task): \(.requirements.spec_deviation) - \(.implementation.summary)"'
    ;;

  *)
    # Show summary of all notes
    echo "# Conductor Audit Summary"
    echo ""
    get_all_notes | jq -r '"[\(.conductor.track_id)] Phase \(.task.phase).Task \(.task.task): \(.implementation.summary)"'
    ;;
esac
