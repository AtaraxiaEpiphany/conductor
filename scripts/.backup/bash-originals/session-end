#!/usr/bin/env bash
# SessionEnd hook: cleanup, consistency validation, and metrics logging.
# Runs on session termination: clear, resume, logout, prompt_input_exit, bypass_permissions_disabled, other.
set -eo pipefail

INPUT=$(cat)

SESSION_ID=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('session_id',''))" 2>/dev/null || echo "")
CWD=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('cwd',''))" 2>/dev/null || echo "")
END_REASON=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('reason',''))" 2>/dev/null || echo "")

# Fallback for plugin root when not set (e.g., during testing)
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
DATA_DIR="${CLAUDE_PLUGIN_DATA:-$PLUGIN_ROOT/.data}"
LOG_DIR="${DATA_DIR}/logs"
mkdir -p "$LOG_DIR"

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Log session end
echo "${TIMESTAMP} session=${SESSION_ID} reason=${END_REASON} event=session_end" >> "${LOG_DIR}/session-lifecycle.log"

# 1. Validate session-handoff.md consistency
HANDOFF_FILE="${DATA_DIR}/session-handoff.md"
if [[ -f "$HANDOFF_FILE" ]]; then
    # Check if handoff is stale (no active tracks should exist)
    if [[ -d "${CWD}/conductor" ]]; then
        TRACKS_FILE="${CWD}/conductor/tracks.md"
        if [[ -f "$TRACKS_FILE" ]]; then
            HAS_ACTIVE=$(python3 -c "
import json, sys
try:
    with open('${TRACKS_FILE}') as f:
        content = f.read()
    import re
    dirs = re.findall(r'\[.*?\]\(([^)]+)\)', content)
    for d in dirs:
        state_file = '${CWD}/' + d + '/track-state.json'
        try:
            with open(state_file) as sf:
                state = json.load(sf)
            status = state.get('status', '')
            if status not in ('completed', 'archived', 'cancelled'):
                print('yes')
                sys.exit(0)
        except:
            pass
    print('no')
except:
    print('no')
" 2>/dev/null || echo "no")

            if [[ "$HAS_ACTIVE" == "no" ]]; then
                # No active tracks but handoff exists - cleanup
                rm -f "$HANDOFF_FILE"
                echo "${TIMESTAMP} cleaned stale session-handoff.md (no active tracks)" >> "${LOG_DIR}/cleanup.log"
            fi
        fi
    fi
fi

# 2. Clean orphaned temp files
TEMP_DIR="${DATA_DIR}/tmp"
if [[ -d "$TEMP_DIR" ]]; then
    # Remove files older than 24 hours
    find "$TEMP_DIR" -type f -mtime +1 -delete 2>/dev/null || true
    # Remove empty directories
    find "$TEMP_DIR" -type d -empty -delete 2>/dev/null || true
fi

# 3. Log session duration if we have start time
SESSION_START_FILE="${DATA_DIR}/logs/.session-${SESSION_ID}.start"
if [[ -f "$SESSION_START_FILE" ]]; then
    START_TIME=$(cat "$SESSION_START_FILE")
    DURATION=$(($(date -u +%s) - START_TIME))
    echo "${TIMESTAMP} session=${SESSION_ID} duration_seconds=${DURATION}" >> "${LOG_DIR}/session-metrics.log"
    rm -f "$SESSION_START_FILE"
fi

# 4. Validate .data/ directory structure
REQUIRED_DIRS=("logs")
for dir in "${REQUIRED_DIRS[@]}"; do
    if [[ ! -d "${DATA_DIR}/${dir}" ]]; then
        mkdir -p "${DATA_DIR}/${dir}"
        echo "${TIMESTAMP} created missing directory ${DATA_DIR}/${dir}" >> "${LOG_DIR}/cleanup.log"
    fi
done

# 5. Emit session summary (non-blocking)
if [[ -f "${LOG_DIR}/session-metrics.log" ]]; then
    RECENT_SESSIONS=$(tail -5 "${LOG_DIR}/session-metrics.log" 2>/dev/null || echo "")
    if [[ -n "$RECENT_SESSIONS" ]]; then
        SUMMARY=$(echo "$RECENT_SESSIONS" | wc -l)
        echo "{\"hookSpecificOutput\": {\"hookEventName\": \"SessionEnd\", \"additionalContext\": \"[Conductor] Session ended. ${SUMMARY} recent sessions logged.\"}}" 2>/dev/null || true
    fi
fi

echo '{}'