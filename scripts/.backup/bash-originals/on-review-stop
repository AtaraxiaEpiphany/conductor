#!/usr/bin/env bash
# Stop hook for code-reviewer:
# After review completes, log the event.
set -euo pipefail

INPUT=$(cat)

LOG_DIR="${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT}/.data}/logs"
mkdir -p "$LOG_DIR"

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
SESSION_ID=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('session_id',''))" 2>/dev/null || echo "")

echo "${TIMESTAMP} session=${SESSION_ID} event=code_review_complete" >> "${LOG_DIR}/review.log"

echo '{}'
