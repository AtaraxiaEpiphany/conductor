#!/usr/bin/env bash
# Stop hook for conductor:implement skill:
# 1. Verifies track-state.json and plan.md markers are consistent.
# 2. Writes session handoff file for next session recovery.
# Returns additionalContext with warning if inconsistencies found.
# Non-blocking — only warns, does not halt.
set -euo pipefail

INPUT=$(cat)

CWD=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('cwd',''))" 2>/dev/null || echo "")

# Find track-state.json files
ISSUES=""
HANDOFF_DATA=""

DATA_DIR="${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT}/.data}"
mkdir -p "$DATA_DIR"

if [[ -d "${CWD}/conductor" ]]; then
  # Look for tracks registry
  TRACKS_FILE="${CWD}/conductor/tracks.md"
  if [[ -f "$TRACKS_FILE" ]]; then
    # Extract track dirs from registry
    TRACK_DIRS=$(grep -oP '\[.*?\]\(([^)]+)\)' "$TRACKS_FILE" 2>/dev/null | grep -oP '(?<=\().*?(?=\))' || true)

    for TRACK_DIR in $TRACK_DIRS; do
      FULL_DIR="${CWD}/${TRACK_DIR}"
      STATE_FILE="${FULL_DIR}/track-state.json"
      PLAN_FILE="${FULL_DIR}/plan.md"

      if [[ -f "$STATE_FILE" ]] && [[ -f "$PLAN_FILE" ]]; then
        # Check for in_progress tasks that shouldn't be (stale locks)
        STALE_LOCKS=$(python3 -c "
import json, sys
try:
    with open('${STATE_FILE}') as f:
        state = json.load(f)
    stale = []
    for pi, phase in enumerate(state.get('phases', [])):
        for ti, task in enumerate(phase.get('tasks', [])):
            if task.get('status') == 'in_progress':
                stale.append(f'Phase {pi+1} Task {ti+1}: {task.get(\"name\", \"\")}')
            for si, sub in enumerate(task.get('subtasks', [])):
                if sub.get('status') == 'in_progress':
                    stale.append(f'Phase {pi+1} Task {ti+1}.{si+1}: {sub.get(\"name\", \"\")}')
    if stale:
        print('; '.join(stale))
    else:
        print('')
except Exception:
    print('')
" 2>/dev/null || echo "")

        if [[ -n "$STALE_LOCKS" ]]; then
          ISSUES="${ISSUES}[Conductor] Stale in_progress tasks found in ${TRACK_DIR}: ${STALE_LOCKS}. "
        fi

        # Collect handoff data: active tracks with status and position
        TRACK_INFO=$(python3 -c "
import json, sys
try:
    with open('${STATE_FILE}') as f:
        state = json.load(f)
    status = state.get('status', 'unknown')
    track_id = state.get('track_id', 'unknown')
    if status not in ('completed', 'archived', 'cancelled'):
        pi = state.get('current_phase_index', -1)
        ti = state.get('current_task_index', -1)
        mode = state.get('execution_mode', 'interactive')
        print(f'- Track {track_id}: status={status}, position=P{pi}.T{ti}, mode={mode}')
except Exception:
    pass
" 2>/dev/null || echo "")
        if [[ -n "$TRACK_INFO" ]]; then
          HANDOFF_DATA="${HANDOFF_DATA}${TRACK_INFO}"$'\n'
        fi
      fi
    done
  fi
fi

# Write session handoff file for next session
HANDOFF_FILE="${DATA_DIR}/session-handoff.md"
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
if [[ -n "$HANDOFF_DATA" ]]; then
  echo "Last session ended: ${TIMESTAMP}" > "$HANDOFF_FILE"
  echo "Active tracks:" >> "$HANDOFF_FILE"
  echo "$HANDOFF_DATA" >> "$HANDOFF_FILE"
  echo "Run /conductor:implement to continue, or /conductor:status for overview." >> "$HANDOFF_FILE"
elif [[ -f "$HANDOFF_FILE" ]]; then
  # Clean up stale handoff if no active tracks
  rm -f "$HANDOFF_FILE"
fi

if [[ -n "$ISSUES" ]]; then
  MSG="${ISSUES}Consider running /conductor:implement to recover state, or /conductor:status to inspect."
  python3 -c "
import json, sys
content = sys.stdin.read()
print(json.dumps({
    'hookSpecificOutput': {
        'hookEventName': 'Stop',
        'additionalContext': content
    }
}))
" <<< "$MSG"
else
  echo '{}'
fi
