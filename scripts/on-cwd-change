#!/usr/bin/env bash
# CwdChanged hook: update context when working directory changes.
# Validates conductor state availability in new directory.
set -euo pipefail

INPUT=$(cat)

OLD_CWD=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('old_cwd',''))" 2>/dev/null || echo "")
NEW_CWD=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('new_cwd',''))" 2>/dev/null || echo "")

DATA_DIR="${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/.data}"
LOG_DIR="${DATA_DIR}/logs"
mkdir -p "$LOG_DIR"

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Log cwd change
echo "${TIMESTAMP} old=${OLD_CWD} new=${NEW_CWD} event=cwd_changed" >> "${LOG_DIR}/cwd-changes.log"

# Check if new directory has conductor setup
if [[ -d "${NEW_CWD}/conductor" ]]; then
    HAS_TRACKS=false
    if [[ -f "${NEW_CWD}/conductor/tracks.md" ]]; then
        TRACK_COUNT=$(grep -c "^- " "${NEW_CWD}/conductor/tracks.md" 2>/dev/null || echo "0")
        HAS_TRACKS=true
    fi

    # Inject context about conductor availability
    if [[ "$HAS_TRACKS" == "true" ]]; then
        python3 -c "
import json, sys
print(json.dumps({
    'hookSpecificOutput': {
        'hookEventName': 'CwdChanged',
        'additionalContext': '[Conductor] Switched to project with ${TRACK_COUNT} track(s). Run /conductor:status for overview.'
    }
}))
"
    else
        echo '{}'
    fi
else
    # Left conductor directory - clear any cached context
    # Could emit warning, but for now just log
    echo '{}'
fi
exit 0