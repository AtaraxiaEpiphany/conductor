#!/usr/bin/env bash
# SessionStart hook: inject conductor-core.md as additionalContext
# Only the Core layer is injected at session start to minimize context footprint.
# Orchestration and Reference layers are loaded on-demand by individual skills.
set -euo pipefail

INSTRUCTIONS="${CLAUDE_PLUGIN_ROOT}/conductor-core.md"

if [[ ! -f "$INSTRUCTIONS" ]]; then
  echo '{"additionalContext":""}'
  exit 0
fi

CONTENT=$(cat "$INSTRUCTIONS")

# Use python for safe JSON encoding (handles quotes, newlines, etc.)
python3 -c "
import json, sys
content = sys.stdin.read()
print(json.dumps({'additionalContext': content}))
" <<< "$CONTENT"
