#!/usr/bin/env bash
# SessionStart hook: inject conductor-core.md + session handoff into session context.
set -euo pipefail

INSTRUCTIONS="${CLAUDE_PLUGIN_ROOT}/conductor-core.md"

if [[ ! -f "$INSTRUCTIONS" ]]; then
  echo '{}'
  exit 0
fi

CONTENT=$(cat "$INSTRUCTIONS")

# Check for session handoff file from previous session
HANDOFF_FILE="${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT}/.data}/session-handoff.md"
HANDOFF_CTX=""
if [[ -f "$HANDOFF_FILE" ]]; then
  HANDOFF_CTX=$'\n\n--- Previous Session Handoff ---\n'"$(cat "$HANDOFF_FILE")"
fi

# Use python for safe JSON encoding (handles quotes, newlines, etc.)
python3 -c "
import json, sys
content = sys.stdin.read()
print(json.dumps({
    'hookSpecificOutput': {
        'hookEventName': 'SessionStart',
        'additionalContext': content
    }
}))
" <<< "${CONTENT}${HANDOFF_CTX}"
