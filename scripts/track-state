#!/usr/bin/env python3
"""track-state — Conductor track state management CLI.

All commands output JSON to stdout. Exit 0 on success, 1 on error.
Keeps orchestrator context clean by handling all JSON/markdown mutations.

Usage:
    track-state next <track-dir> [--compact]
    track-state recover <track-dir> [--compact]
    track-state lock <track-dir> <phase> <task> [<subtask>]
    track-state complete <track-dir> <phase> <task> [<subtask>] --sha <sha>
    track-state fail <track-dir> <phase> <task> [<subtask>] --summary <text>
    track-state skip <track-dir> <phase> <task> [<subtask>] --reason <text>
    track-state defer <track-dir> <phase> <task> [<subtask>] --reason <text>
    track-state block <track-dir> <phase> <task> [<subtask>] --reason <text>
    track-state deferred-report <track-dir>
    track-state sync-plan <track-dir>
    track-state registry-update <track-dir> <tracks-md-path>
    track-state start <track-dir>
    track-state validate <track-dir>
    track-state phase-done <track-dir> <phase>
    track-state add-checkpoint <track-dir> <phase> <sha>
    track-state finalize <track-dir>
    track-state process-result <track-dir>
    track-state init <track-dir> --plan-structure <json> --track-id <id> --type <type> --description <desc>
"""

import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

MARKER_MAP = {
    "pending": " ",
    "in_progress": "~",
    "completed": "x",
    "failed": "!",
    "skipped": ">",
    "deferred": "d",
    "blocked": "#",
    "cancelled": "-",
}

SHA_MARKERS = {"x", "!", ">", "#", "-", "d"}


# ── Utilities ─────────────────────────────────────────────────────────


def load(track_dir):
    with open(Path(track_dir) / "track-state.json") as f:
        return json.load(f)


def save(track_dir, state):
    with open(Path(track_dir) / "track-state.json", "w") as f:
        json.dump(state, f, indent=2, ensure_ascii=False)
        f.write("\n")


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))


def out_compact(obj):
    """Ultra-compact single-line output for --compact mode."""
    if obj.get("phase", -1) < 0:
        print("ALL_DONE")
        return
    p, t = obj.get("phase", "?"), obj.get("task", "?")
    s = obj.get("subtask")
    name = obj.get("name", "?")
    ttype = obj.get("type", "?")
    tags = ",".join(obj.get("tags", []))
    status = obj.get("status", "")
    loc = f"P{p}.T{t}" + (f".S{s}" if s is not None else "")
    parts = [loc, name, ttype]
    if tags:
        parts.append(f"tags=[{tags}]")
    if status:
        parts.append(f"status={status}")
    retry = obj.get("retry_count")
    if retry:
        parts.append(f"retry={retry}")
    print(" | ".join(parts))


def target(state, p, t, s=None):
    task = state["phases"][p]["tasks"][t]
    if s is not None and "subtasks" in task:
        return task["subtasks"][s]
    return task


def clean(tgt, keep):
    for k in ["commit_sha", "completed_at", "retry_count", "last_failure_summary", "skip_analysis"]:
        if k not in keep:
            tgt.pop(k, None)


def extract_tags(name):
    return re.findall(r"\[(Explore|Docs|Config|Chore|Manual)\]", name)


def conductor_dir(track_dir):
    d = Path(track_dir) / ".conductor"
    d.mkdir(exist_ok=True)
    return d


# ── Internal State Operations ────────────────────────────────────────
# These perform state mutations without printing output.
# Used by both public commands and process-result.


def _do_lock(track_dir, p, t, s=None):
    state = load(track_dir)
    pi, ti = int(p), int(t)
    si = int(s) if s is not None else None

    tgt = target(state, pi, ti, si)
    tgt["status"] = "in_progress"
    clean(tgt, {"status"})

    state["current_phase_index"] = pi
    state["current_task_index"] = ti
    if si is not None:
        state["current_subtask_index"] = si
        parent = state["phases"][pi]["tasks"][ti]
        if parent["status"] != "in_progress":
            parent["status"] = "in_progress"
    else:
        state.pop("current_subtask_index", None)

    state["updated_at"] = now_iso()
    save(track_dir, state)


def _do_complete(track_dir, p, t, s=None, sha=None):
    """Returns parent_completed bool."""
    state = load(track_dir)
    pi, ti = int(p), int(t)
    si = int(s) if s is not None else None

    tgt = target(state, pi, ti, si)
    tgt["status"] = "completed"
    tgt["commit_sha"] = sha or ""
    tgt["completed_at"] = now_iso()
    clean(tgt, {"status", "commit_sha", "completed_at"})

    parent_completed = False
    if si is not None:
        parent = state["phases"][pi]["tasks"][ti]
        if all(sub["status"] in ("completed", "skipped", "deferred") for sub in parent.get("subtasks", [])):
            parent["status"] = "completed"
            parent["commit_sha"] = sha or ""
            parent["completed_at"] = now_iso()
            clean(parent, {"status", "commit_sha", "completed_at"})
            parent_completed = True
    elif "subtasks" in tgt:
        # When completing a task directly (no subtask specified),
        # auto-complete all remaining non-terminal subtasks
        for sub in tgt["subtasks"]:
            if sub["status"] not in ("completed", "skipped", "deferred", "blocked", "cancelled"):
                sub["status"] = "completed"
                sub["commit_sha"] = sha or ""
                sub["completed_at"] = now_iso()

    state["updated_at"] = now_iso()
    save(track_dir, state)
    return parent_completed


def _do_fail(track_dir, p, t, s=None, summary=""):
    """Returns retry_count."""
    state = load(track_dir)
    pi, ti = int(p), int(t)
    si = int(s) if s is not None else None

    tgt = target(state, pi, ti, si)
    tgt["status"] = "failed"
    tgt["retry_count"] = tgt.get("retry_count", -1) + 1
    tgt["last_failure_summary"] = summary
    clean(tgt, {"status", "retry_count", "last_failure_summary"})

    state["updated_at"] = now_iso()
    save(track_dir, state)
    return tgt["retry_count"]


def _do_skip(track_dir, p, t, s=None, reason=""):
    state = load(track_dir)
    pi, ti = int(p), int(t)
    si = int(s) if s is not None else None

    tgt = target(state, pi, ti, si)
    tgt["status"] = "skipped"
    tgt["skip_analysis"] = reason
    clean(tgt, {"status", "skip_analysis"})

    if si is None and "subtasks" in tgt:
        for sub in tgt["subtasks"]:
            if sub["status"] not in ("completed", "skipped", "deferred", "blocked", "cancelled"):
                sub["status"] = "skipped"
                sub["skip_analysis"] = reason

    state["updated_at"] = now_iso()
    save(track_dir, state)


def _do_block(track_dir, p, t, s=None, reason=""):
    state = load(track_dir)
    pi, ti = int(p), int(t)
    si = int(s) if s is not None else None

    tgt = target(state, pi, ti, si)
    tgt["status"] = "blocked"
    tgt["skip_analysis"] = reason
    clean(tgt, {"status", "skip_analysis"})

    if si is None and "subtasks" in tgt:
        for sub in tgt["subtasks"]:
            if sub["status"] not in ("completed", "skipped", "deferred", "blocked", "cancelled"):
                sub["status"] = "blocked"
                sub["skip_analysis"] = reason

    state["updated_at"] = now_iso()
    save(track_dir, state)


def _do_defer(track_dir, p, t, s=None, reason=""):
    state = load(track_dir)
    pi, ti = int(p), int(t)
    si = int(s) if s is not None else None

    tgt = target(state, pi, ti, si)
    tgt["status"] = "deferred"
    tgt["defer_reason"] = reason
    clean(tgt, {"status", "defer_reason"})

    parent_deferred = False
    if si is not None:
        parent = state["phases"][pi]["tasks"][ti]
        if all(sub["status"] in ("completed", "skipped", "deferred") for sub in parent.get("subtasks", [])):
            parent["status"] = "deferred"
            parent["defer_reason"] = "All subtasks deferred or completed"
            clean(parent, {"status", "defer_reason"})
            parent_deferred = True
    elif "subtasks" in tgt:
        for sub in tgt["subtasks"]:
            if sub["status"] not in ("completed", "skipped", "deferred", "blocked", "cancelled"):
                sub["status"] = "deferred"
                sub["defer_reason"] = reason

    state["updated_at"] = now_iso()
    save(track_dir, state)
    return parent_deferred


def _do_sync_plan(track_dir):
    """Sync plan.md markers from state. Returns synced count."""
    state = load(track_dir)
    plan_path = Path(track_dir) / "plan.md"

    with open(plan_path) as f:
        lines = f.readlines()

    result = []
    phase_idx = -1
    task_idx = -1
    subtask_idx = -1
    synced = 0

    for line in lines:
        stripped = line.rstrip("\n")

        pm = re.match(r"^##\s+Phase\s+(\d+)", stripped)
        if pm:
            phase_idx = int(pm.group(1)) - 1
            task_idx = -1
            subtask_idx = -1
            result.append(stripped)
            continue

        tm = re.match(r"^(\s*)-\s+\[([ x~!>#\-])\]\s+(.*)", stripped)
        if tm:
            indent = tm.group(1)
            rest = tm.group(3)
            is_subtask = len(indent) > 0

            # Clean trailing markers: [sha], [sha1,sha2,...], [N/A], [verified]
            # while preserving [AC-x], [TC-x]
            # Iteratively remove trailing markers to handle multiple consecutive markers
            def clean_trailing_markers(text):
                single_marker = r'\s*\[(?:N/A|verified|[0-9a-f]{7}(?:\s*,\s*[0-9a-f]{7})*)\]\s*$'
                prev = text
                while True:
                    cleaned = re.sub(single_marker, '', prev)
                    if cleaned == prev:
                        break
                    prev = cleaned
                return prev

            rest_clean = clean_trailing_markers(rest)

            try:
                if is_subtask:
                    subtask_idx += 1
                    sub = state["phases"][phase_idx]["tasks"][task_idx]["subtasks"][subtask_idx]
                    parent_task = state["phases"][phase_idx]["tasks"][task_idx]
                    # If parent is completed, subtasks inherit completed status
                    if parent_task["status"] in ("completed",):
                        marker = MARKER_MAP["completed"]
                        sha = parent_task.get("commit_sha", "")
                    else:
                        marker = MARKER_MAP.get(sub["status"], " ")
                        sha = sub.get("commit_sha", "")
                else:
                    task_idx += 1
                    subtask_idx = -1
                    t = state["phases"][phase_idx]["tasks"][task_idx]
                    marker = MARKER_MAP.get(t["status"], " ")
                    sha = t.get("commit_sha", "")

                new_line = f"{indent}- [{marker}] {rest_clean}"
                # Only append sha if it's a valid non-empty 7-char hex string
                if sha and marker in SHA_MARKERS and re.match(r"^[0-9a-f]{7}$", sha):
                    new_line += f" [{sha}]"
                result.append(new_line)
                synced += 1
                continue
            except (IndexError, KeyError):
                result.append(stripped)
                continue

        result.append(stripped)

    with open(plan_path, "w") as f:
        f.write("\n".join(result))
        f.write("\n")

    return synced


# ── Issues.md Management ─────────────────────────────────────────────


def _append_failure(track_dir, result_data):
    """Append a failure entry to issues.md."""
    issues_path = Path(track_dir) / "issues.md"
    ts = now_iso()
    task_name = result_data.get("task_name", "unknown")
    attempt = result_data.get("attempt", 1)
    max_retries = result_data.get("max_retries", 3)
    detail = result_data.get("failure_detail", {})

    header = ""
    if not issues_path.exists():
        track_id = result_data.get("track_id", "unknown")
        header = f"# Track: {track_id} — Failure Reports\n\n"

    entry = (
        f"### Task: {task_name} | Attempt: {attempt}/{max_retries} | {ts}\n"
        f"**What Was Done**: {detail.get('what_was_done', 'N/A')}\n"
        f"**Failure Reason**: {detail.get('failure_reason', 'N/A')}\n"
        f"**Suggested Next Step**: {detail.get('suggested_next_step', 'N/A')}\n"
        "---\n\n"
    )

    with open(issues_path, "a") as f:
        f.write(header + entry)


def _append_deviation(track_dir, task_name, dev):
    """Append a spec deviation entry to issues.md."""
    issues_path = Path(track_dir) / "issues.md"
    ts = now_iso()

    header = ""
    if not issues_path.exists():
        track_id = "unknown"
        # Try to get track_id from state
        try:
            state = load(track_dir)
            track_id = state.get("track_id", "unknown")
        except Exception:
            pass
        header = f"# Track: {track_id} — Failure Reports\n\n"

    entry = (
        f"### Spec Deviation: {task_name} | {ts}\n"
        f"**AC**: {dev.get('ac_id', 'N/A')} | "
        f"**Reason**: {dev.get('reason', 'N/A')} | "
        f"**Revision**: {dev.get('suggested_revision', 'N/A')} | "
        f"**Status**: pending-review\n"
        "---\n\n"
    )

    with open(issues_path, "a") as f:
        f.write(header + entry)


# ── Public Commands ──────────────────────────────────────────────────


def cmd_next(track_dir, compact=False):
    state = load(track_dir)
    result = None
    # Pass 1: in_progress tasks (recovery / dispatch continuation)
    for pi, phase in enumerate(state["phases"]):
        for ti, task in enumerate(phase["tasks"]):
            if task["status"] == "in_progress":
                subs = task.get("subtasks")
                if subs:
                    for si, sub in enumerate(subs):
                        if sub["status"] in ("in_progress", "pending"):
                            result = dict(phase=pi, task=ti, subtask=si,
                                          name=sub["name"], type="subtask",
                                          tags=extract_tags(sub["name"]))
                            break
                    if not result:
                        result = dict(phase=pi, task=ti, subtask=None,
                                      name=task["name"], type="parent-complete", tags=[])
                else:
                    result = dict(phase=pi, task=ti, subtask=None,
                                  name=task["name"], type="flat",
                                  tags=extract_tags(task["name"]))
                break
        if result:
            break
    # Pass 2: pending tasks (new dispatch)
    if not result:
        for pi, phase in enumerate(state["phases"]):
            for ti, task in enumerate(phase["tasks"]):
                if task["status"] == "pending":
                    subs = task.get("subtasks")
                    if subs:
                        for si, sub in enumerate(subs):
                            if sub["status"] == "pending":
                                result = dict(phase=pi, task=ti, subtask=si,
                                              name=sub["name"], type="subtask",
                                              tags=extract_tags(sub["name"]))
                                break
                        if not result:
                            continue
                    else:
                        result = dict(phase=pi, task=ti, subtask=None,
                                      name=task["name"], type="flat",
                                      tags=extract_tags(task["name"]))
                    break
            if result:
                break
    if not result:
        result = dict(phase=-1, task=-1, subtask=None, name=None, type=None, tags=[])
    if compact:
        out_compact(result)
    else:
        out(result)


def cmd_recover(track_dir, compact=False):
    state = load(track_dir)
    pi = state.get("current_phase_index", -1)
    ti = state.get("current_task_index", -1)
    si = state.get("current_subtask_index")

    if pi < 0 or ti < 0:
        result = dict(status="no_active_task")
        if compact:
            print("NO_ACTIVE_TASK")
        else:
            out(result)
        return

    try:
        task = state["phases"][pi]["tasks"][ti]
    except IndexError:
        result = dict(status="no_active_task")
        if compact:
            print("NO_ACTIVE_TASK")
        else:
            out(result)
        return

    if si is not None and "subtasks" in task:
        si = min(si, len(task["subtasks"]) - 1)
        tgt = task["subtasks"][si]
        name = tgt["name"]
        ttype = "subtask"
    else:
        tgt = task
        name = task["name"]
        ttype = "flat"

    result = dict(
        status=tgt.get("status", "pending"),
        phase=pi, task=ti, subtask=si,
        name=name, type=ttype,
        retry_count=tgt.get("retry_count", 0),
        last_failure_summary=tgt.get("last_failure_summary"),
        tags=extract_tags(name),
    )
    if compact:
        out_compact(result)
    else:
        out(result)


def cmd_lock(track_dir, p, t, s=None):
    _do_lock(track_dir, p, t, s)
    out(dict(ok=True))


def cmd_complete(track_dir, p, t, s=None, sha=None):
    parent_completed = _do_complete(track_dir, p, t, s, sha)
    out(dict(ok=True, parent_completed=parent_completed))


def cmd_fail(track_dir, p, t, s=None, summary=""):
    retry_count = _do_fail(track_dir, p, t, s, summary)
    out(dict(retry_count=retry_count))


def cmd_skip(track_dir, p, t, s=None, reason=""):
    _do_skip(track_dir, p, t, s, reason)
    out(dict(ok=True))


def cmd_block(track_dir, p, t, s=None, reason=""):
    _do_block(track_dir, p, t, s, reason)
    out(dict(ok=True))


def cmd_defer(track_dir, p, t, s=None, reason=""):
    parent_deferred = _do_defer(track_dir, p, t, s, reason)
    out(dict(ok=True, parent_deferred=parent_deferred))


def cmd_deferred_report(track_dir):
    """List all deferred tasks with their context for final verification."""
    state = load(track_dir)
    deferred = []
    for pi, phase in enumerate(state["phases"]):
        for ti, task in enumerate(phase["tasks"]):
            if task["status"] == "deferred":
                deferred.append(dict(
                    phase=pi, task=ti, subtask=None,
                    name=task["name"], reason=task.get("defer_reason", ""),
                    phase_name=phase["name"],
                ))
            for si, sub in enumerate(task.get("subtasks", [])):
                if sub["status"] == "deferred":
                    deferred.append(dict(
                        phase=pi, task=ti, subtask=si,
                        name=sub["name"], reason=sub.get("defer_reason", ""),
                        phase_name=phase["name"],
                    ))
    out(dict(deferred=deferred, count=len(deferred)))


def cmd_finalize(track_dir):
    state = load(track_dir)
    state["current_phase_index"] = -1
    state["current_task_index"] = -1
    state.pop("current_subtask_index", None)

    statuses = []
    for phase in state["phases"]:
        for task in phase["tasks"]:
            statuses.append(task["status"])
            for sub in task.get("subtasks", []):
                statuses.append(sub["status"])

    if "blocked" in statuses:
        state["status"] = "blocked"
    elif all(s in ("completed", "skipped", "deferred") for s in statuses):
        state["status"] = "completed"
    else:
        state["status"] = "completed"

    state["updated_at"] = now_iso()
    save(track_dir, state)
    out(dict(status=state["status"]))


def cmd_phase_done(track_dir, p):
    state = load(track_dir)
    phase = state["phases"][int(p)]
    terminal = {"completed", "skipped", "cancelled", "blocked", "deferred"}
    total = 0
    done = 0
    for task in phase["tasks"]:
        total += 1
        if task["status"] in terminal:
            done += 1
        for sub in task.get("subtasks", []):
            total += 1
            if sub["status"] in terminal:
                done += 1
    out(dict(complete=done == total, terminal=done, total=total))


def cmd_sync_plan(track_dir):
    synced = _do_sync_plan(track_dir)
    out(dict(synced=synced))


def cmd_registry_update(track_dir, tracks_md_path):
    """Update a track's entry in the Tracks Registry (tracks.md) based on track-state.json status.

    Handles two formats:
    1. Section-based: ### TrackID ... - **Status:** value ... - **Path:** [link](dir/)
    2. Checkbox: - [marker] description (path/)
    """
    state = load(track_dir)
    track_dir_path = Path(track_dir).resolve()
    track_status = state.get("status", "new")
    track_id = state.get("track_id", "")

    registry_path = Path(tracks_md_path)
    if not registry_path.exists():
        out(dict(error=f"Tracks registry not found: {tracks_md_path}"))
        return

    content = registry_path.read_text()
    track_dir_name = track_dir_path.name

    status_to_marker = {
        "new": " ",
        "in_progress": "~",
        "completed": "x",
        "blocked": "#",
        "cancelled": "-",
    }
    new_marker = status_to_marker.get(track_status, " ")

    lines = content.split("\n")
    updated = False
    in_track_section = False

    for i, line in enumerate(lines):
        # Detect track section start: ### heading containing track dir name or track_id
        if re.match(r"^###\s+", line):
            in_track_section = track_dir_name in line or track_id in line

        # Format 1: Section-based — **Status:** value
        if in_track_section and re.match(r"^\s*-\s+\*\*Status:\*\*\s+", line):
            old_status = re.sub(r"^\s*-\s+\*\*Status:\*\*\s+", "", line).strip()
            if old_status != track_status:
                lines[i] = f"- **Status:** {track_status}"
                updated = True
            continue

        # Format 2: Checkbox — [marker] ... (path/)
        m = re.match(r"^(\s*-\s+\[)([ x~!>#\-])(\]\s+.*?\()([^)]*)(\).*)$", line)
        if m:
            prefix, old_marker, mid, link_path, suffix = m.groups()
            if track_dir_name in link_path or str(track_dir_path) in link_path:
                if old_marker != new_marker:
                    lines[i] = f"{prefix}{new_marker}{mid}{link_path}{suffix}"
                    updated = True
                break

    # Also update table row if present: | id | type | status | desc |
    for i, line in enumerate(lines):
        if re.match(r"^\|", line) and (track_id in line or track_dir_name in line):
            parts = [p.strip() for p in line.split("|")]
            # Find the status column (typically 3rd, index 3 after split)
            if len(parts) >= 4:
                new_line = line
                # Replace status in table — status is 3rd data column
                new_line = re.sub(
                    r"\|\s*(new|in_progress|completed|blocked|cancelled)\s*\|",
                    f"| {track_status} |",
                    new_line,
                    count=1,
                )
                if new_line != line:
                    lines[i] = new_line
                    updated = True

    if updated:
        registry_path.write_text("\n".join(lines))
        out(dict(updated=True, marker=new_marker, status=track_status))
    else:
        out(dict(updated=False, status=track_status))


def cmd_start(track_dir):
    """Transition a track from 'new' to 'in_progress'."""
    state = load(track_dir)
    if state.get("status") != "new":
        out(dict(ok=True, status=state.get("status"), message="already started"))
        return

    state["status"] = "in_progress"
    state["updated_at"] = now_iso()
    save(track_dir, state)
    out(dict(ok=True, status="in_progress"))


def _validate_state_consistency(state, errors, warnings):
    """Check semantic consistency within track-state.json."""
    TERMINAL = {"completed", "skipped", "deferred", "blocked", "cancelled"}

    for pi, phase in enumerate(state.get("phases", [])):
        pname = phase.get("name", f"Phase {pi+1}")
        tasks = phase.get("tasks", [])

        # Phase has no tasks
        if not tasks:
            errors.append(f"{pname}: phase has no tasks")
            continue

        # All tasks/subtasks terminal but phase not terminal
        all_terminal = True
        for task in tasks:
            if task["status"] not in TERMINAL:
                all_terminal = False
            for sub in task.get("subtasks", []):
                if sub["status"] not in TERMINAL:
                    all_terminal = False
        if all_terminal and phase["status"] not in TERMINAL:
            warnings.append(f"{pname}: all tasks terminal but phase status is '{phase['status']}'")

        # Phase terminal but some tasks not
        if phase["status"] in TERMINAL and not all_terminal:
            warnings.append(f"{pname}: phase terminal but tasks still in progress")

        # Multiple in_progress tasks in same phase
        in_progress = [t.get("name", f"P{pi}.T{ti}")
                       for ti, t in enumerate(tasks) if t["status"] == "in_progress"]
        if len(in_progress) > 1:
            warnings.append(f"{pname}: multiple in_progress tasks ({', '.join(in_progress)})")

        for ti, task in enumerate(tasks):
            tname = task.get("name", f"P{pi}.T{ti}")

            # Parent completed but subtasks pending
            if task["status"] in TERMINAL:
                pending_subs = [s.get("name", f"S{si}")
                                for si, s in enumerate(task.get("subtasks", []))
                                if s["status"] in ("pending", "in_progress")]
                if pending_subs:
                    warnings.append(
                        f"{tname}: parent '{task['status']}' but subtasks still pending: "
                        f"{', '.join(pending_subs)}")

            # Completed task missing SHA
            if task["status"] == "completed" and not task.get("commit_sha"):
                warnings.append(f"{tname}: completed but no commit_sha")


def _validate_plan_consistency(track_dir, state, errors, warnings):
    """Cross-check plan.md against track-state.json."""
    plan_path = Path(track_dir) / "plan.md"
    if not plan_path.exists():
        warnings.append("plan.md not found — skipping plan consistency checks")
        return

    with open(plan_path) as f:
        lines = f.readlines()

    TERMINAL = {"completed", "skipped", "deferred", "blocked", "cancelled"}

    # Build plan structure: count tasks/subtasks per phase, detect checkpoint markers
    plan_phases = []  # list of {heading_has_checkpoint: bool, task_count, subtask_counts}
    current_phase = None

    for line in lines:
        stripped = line.rstrip("\n")

        pm = re.match(r"^##\s+Phase\s+(\d+)", stripped)
        if pm:
            has_checkpoint = bool(re.search(r"\[checkpoint:\s*[0-9a-f]{7}\]", stripped))
            current_phase = {"has_checkpoint": has_checkpoint, "tasks": 0, "subtasks": 0}
            plan_phases.append(current_phase)
            continue

        tm = re.match(r"^(\s*)-\s+\[([ x~!>#\-])\]\s+", stripped)
        if tm and current_phase is not None:
            indent = tm.group(1)
            if len(indent) > 0:
                current_phase["subtasks"] += 1
            else:
                current_phase["tasks"] += 1

    # Cross-check each phase
    for pi, phase in enumerate(state.get("phases", [])):
        pname = phase.get("name", f"Phase {pi+1}")
        tasks = phase.get("tasks", [])

        if pi >= len(plan_phases):
            warnings.append(f"{pname}: phase heading missing in plan.md")
            continue

        pp = plan_phases[pi]

        # Count mismatch: tasks
        state_tasks = len(tasks)
        if pp["tasks"] != state_tasks:
            errors.append(f"{pname}: plan.md has {pp['tasks']} tasks, state has {state_tasks}")

        # Count mismatch: subtasks
        state_subs = sum(len(t.get("subtasks", [])) for t in tasks)
        if pp["subtasks"] != state_subs:
            errors.append(f"{pname}: plan.md has {pp['subtasks']} subtasks, state has {state_subs}")

        # Missing checkpoint: all tasks terminal but no checkpoint marker
        all_terminal = all(
            t["status"] in TERMINAL and
            all(s["status"] in TERMINAL for s in t.get("subtasks", []))
            for t in tasks
        )
        if all_terminal and not pp["has_checkpoint"]:
            warnings.append(f"{pname}: all tasks complete but no checkpoint in plan.md")


def cmd_validate(track_dir):
    """Validate track-state.json and plan.md against structural and semantic rules."""
    errors = []
    warnings = []
    try:
        state = load(track_dir)
    except Exception as e:
        out(dict(valid=False, errors=[f"Cannot read track-state.json: {e}"], warnings=[]))
        return

    # Top-level required fields
    for field in ["track_id", "type", "status", "description", "current_phase_index",
                   "current_task_index", "updated_at", "phases"]:
        if field not in state:
            errors.append(f"Missing required field: {field}")

    if errors:
        out(dict(valid=False, errors=errors, warnings=[]))
        return

    # Enum checks
    if state["type"] not in ("feature", "bugfix", "chore", "docs"):
        errors.append(f"Invalid type: {state['type']}")
    if state["status"] not in ("new", "in_progress", "completed", "blocked", "cancelled"):
        errors.append(f"Invalid track status: {state['status']}")

    # Index checks
    cpi = state["current_phase_index"]
    cti = state["current_task_index"]
    if cpi < -1 or cpi >= len(state.get("phases", [])):
        errors.append(f"current_phase_index {cpi} out of range")
    if cti < -1:
        errors.append(f"current_task_index {cti} out of range")

    # Phase validation
    TASK_STATUSES = {"pending", "in_progress", "completed", "failed", "skipped",
                     "deferred", "blocked", "cancelled"}
    for pi, phase in enumerate(state.get("phases", [])):
        pname = phase.get("name", f"Phase {pi+1}")
        if "name" not in phase:
            errors.append(f"Phase {pi}: missing name")
        if "status" not in phase:
            errors.append(f"{pname}: missing status")
        elif phase["status"] not in TASK_STATUSES:
            errors.append(f"{pname}: invalid status '{phase['status']}'")
        if "tasks" not in phase:
            errors.append(f"{pname}: missing tasks array")
            continue

        for ti, task in enumerate(phase["tasks"]):
            tname = task.get("name", f"P{pi}.T{ti}")
            if "name" not in task:
                errors.append(f"Phase {pi} Task {ti}: missing name")
            if "status" not in task:
                errors.append(f"{tname}: missing status")
            elif task["status"] not in TASK_STATUSES:
                errors.append(f"{tname}: invalid status '{task['status']}'")

            for si, sub in enumerate(task.get("subtasks", [])):
                sname = sub.get("name", f"P{pi}.T{ti}.S{si}")
                if "status" not in sub:
                    errors.append(f"{sname}: missing status")
                elif sub["status"] not in TASK_STATUSES:
                    errors.append(f"{sname}: invalid status '{sub['status']}'")

            # Validate optional fields
            sha = task.get("commit_sha")
            if sha is not None and sha != "" and (not isinstance(sha, str) or len(sha) > 7):
                errors.append(f"{tname}: commit_sha must be empty or 1-7 hex chars")

    # Semantic consistency checks
    _validate_state_consistency(state, errors, warnings)
    _validate_plan_consistency(track_dir, state, errors, warnings)

    out(dict(valid=len(errors) == 0, errors=errors, warnings=warnings))


def cmd_shas(track_dir):
    """Extract all commit SHAs from completed tasks. Returns first/last for revision range."""
    state = load(track_dir)
    shas = []
    for phase in state["phases"]:
        for task in phase["tasks"]:
            sha = task.get("commit_sha", "")
            if sha and task["status"] in ("completed", "skipped", "failed", "blocked", "deferred", "cancelled"):
                shas.append(sha)
            for sub in task.get("subtasks", []):
                sha = sub.get("commit_sha", "")
                if sha and sub["status"] in ("completed", "skipped", "failed", "blocked", "deferred", "cancelled"):
                    shas.append(sha)
    out(dict(
        shas=shas,
        first=shas[0] if shas else None,
        last=shas[-1] if shas else None,
        count=len(shas),
    ))


def cmd_add_checkpoint(track_dir, p, sha):
    """Add or update checkpoint SHA for a phase in plan.md."""
    plan_path = Path(track_dir) / "plan.md"

    if not plan_path.exists():
        out(dict(error="plan.md not found"))
        return

    # Validate sha format
    if not re.match(r"^[0-9a-f]{7}$", sha):
        out(dict(error="Invalid SHA format: must be 7 hex characters"))
        return

    with open(plan_path) as f:
        lines = f.readlines()

    result = []
    phase_num = int(p) + 1  # Convert to 1-based for heading match
    found = False

    for line in lines:
        stripped = line.rstrip("\n")
        # Match phase heading: ## Phase 1: ... or ## Phase 1
        pm = re.match(rf"^##\s+Phase\s+{phase_num}\b", stripped)
        if pm:
            # Remove existing checkpoint if present
            base = re.sub(r"\s+\[checkpoint:\s*[0-9a-f]+\]$", "", stripped)
            # Add new checkpoint
            updated = f"{base} [checkpoint: {sha}]"
            result.append(updated)
            found = True
        else:
            result.append(stripped)

    if not found:
        out(dict(error=f"Phase {p} heading not found in plan.md"))
        return

    with open(plan_path, "w") as f:
        f.write("\n".join(result))
        if result and not result[-1].endswith("\n"):
            f.write("\n")

    out(dict(ok=True, phase=p, sha=sha))


def cmd_process_result(track_dir):
    """Read .conductor/result.json, update state, sync plan, manage issues.
    Outputs minimal JSON summary. Deletes result file after processing."""
    result_path = conductor_dir(track_dir) / "result.json"

    if not result_path.exists():
        out(dict(error="No result file at .conductor/result.json"))
        return

    with open(result_path) as f:
        r = json.load(f)

    status = r.get("status", "").upper()
    p = str(r.get("phase", ""))
    t = str(r.get("task", ""))
    s = r.get("subtask")
    if s is not None:
        s = str(s)
    task_name = r.get("task_name", "unknown")

    if status == "SUCCESS":
        sha = r.get("commit_sha", "")
        parent_completed = _do_complete(track_dir, p, t, s, sha)
        _do_sync_plan(track_dir)

        # Handle spec deviations
        deviations = r.get("spec_deviation_detail", [])
        for dev in deviations:
            _append_deviation(track_dir, task_name, dev)

        # Clean up
        result_path.unlink(missing_ok=True)

        out(dict(
            status="success",
            sha=sha,
            parent_completed=parent_completed,
            deviations=len(deviations),
        ))

    elif status == "FAILURE":
        summary = r.get("summary", "")
        retry_count = _do_fail(track_dir, p, t, s, summary)
        _do_sync_plan(track_dir)

        # Append to issues.md
        _append_failure(track_dir, r)

        # Clean up
        result_path.unlink(missing_ok=True)

        out(dict(
            status="failure",
            retry_count=retry_count,
            summary=summary,
        ))

    else:
        out(dict(error=f"Unknown status: {status}"))


# ── Init (Track Creation) ────────────────────────────────────────────


def cmd_init(track_dir, plan_structure_json, track_id, track_type, description):
    """Create track-state.json and index.md from PLAN_STRUCTURE.
    Returns compact result — eliminates duplicate JSON generation in orchestrator."""
    plan = json.loads(plan_structure_json)
    track_path = Path(track_dir)
    track_path.mkdir(parents=True, exist_ok=True)

    # Build track-state.json from PLAN_STRUCTURE
    phases = []
    for phase in plan.get("phases", []):
        tasks = []
        for task in phase.get("tasks", []):
            entry = {"name": task["name"], "status": "pending"}
            if "subtasks" in task:
                entry["subtasks"] = [{"name": st, "status": "pending"} for st in task["subtasks"]]
            tasks.append(entry)
        phases.append({"name": phase["name"], "status": "pending", "tasks": tasks})

    state = {
        "track_id": track_id,
        "type": track_type,
        "status": "new",
        "description": description,
        "current_phase_index": 0,
        "current_task_index": 0,
        "updated_at": now_iso(),
        "phases": phases,
    }

    with open(track_path / "track-state.json", "w") as f:
        json.dump(state, f, indent=2, ensure_ascii=False)
        f.write("\n")

    # Create index.md from template
    plugin_root = os.environ.get("CLAUDE_PLUGIN_ROOT", "")
    template_path = Path(plugin_root) / "templates" / "track-index.md" if plugin_root else None
    index_content = None
    if template_path and template_path.exists():
        index_content = template_path.read_text().replace("{TRACK_ID}", track_id)

    if index_content:
        with open(track_path / "index.md", "w") as f:
            f.write(index_content)
    else:
        # Fallback: minimal index
        with open(track_path / "index.md", "w") as f:
            f.write(f"# Track {track_id} Context\n\n")
            f.write("> Paths are relative to this track directory.\n\n")
            f.write("## Track Files\n")
            f.write("- [Specification](./spec.md)\n")
            f.write("- [Implementation Plan](./plan.md)\n")
            f.write("- [Track State](./track-state.json)\n")
            f.write("- [Issues Log](./issues.md) (created lazily on first failure)\n")

    task_count = sum(len(p.get("tasks", [])) for p in phases)
    out(dict(ok=True, track_id=track_id, phases=len(phases), tasks=task_count))


# ── Dispatch ─────────────────────────────────────────────────────────


def flag(args, name):
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
    return None


_BOOL_FLAGS = {"--compact"}


def positional(args):
    """Extract positional args, skipping flags and their values."""
    result = []
    skip = False
    for a in args:
        if skip:
            skip = False
            continue
        if a.startswith("--"):
            if a not in _BOOL_FLAGS:
                skip = True
            continue
        result.append(a)
    return result


def main():
    if len(sys.argv) < 3:
        print("Usage: track-state <command> <track-dir> [args...]", file=sys.stderr)
        sys.exit(1)

    cmd = sys.argv[1]
    track_dir = sys.argv[2]
    args = sys.argv[3:]
    pos = positional(args)

    try:
        if cmd == "next":
            cmd_next(track_dir, compact="--compact" in args)
        elif cmd == "recover":
            cmd_recover(track_dir, compact="--compact" in args)
        elif cmd == "lock":
            cmd_lock(track_dir, pos[0], pos[1], pos[2] if len(pos) > 2 else None)
        elif cmd == "complete":
            cmd_complete(track_dir, pos[0], pos[1],
                         pos[2] if len(pos) > 2 else None,
                         flag(args, "--sha"))
        elif cmd == "fail":
            cmd_fail(track_dir, pos[0], pos[1],
                     pos[2] if len(pos) > 2 else None,
                     flag(args, "--summary") or "")
        elif cmd == "skip":
            cmd_skip(track_dir, pos[0], pos[1],
                     pos[2] if len(pos) > 2 else None,
                     flag(args, "--reason") or "")
        elif cmd == "block":
            cmd_block(track_dir, pos[0], pos[1],
                      pos[2] if len(pos) > 2 else None,
                      flag(args, "--reason") or "")
        elif cmd == "defer":
            cmd_defer(track_dir, pos[0], pos[1],
                      pos[2] if len(pos) > 2 else None,
                      flag(args, "--reason") or "")
        elif cmd == "deferred-report":
            cmd_deferred_report(track_dir)
        elif cmd == "sync-plan":
            cmd_sync_plan(track_dir)
        elif cmd == "registry-update":
            if len(pos) < 1:
                out(dict(error="Missing tracks-md-path argument"))
                sys.exit(1)
            cmd_registry_update(track_dir, pos[0])
        elif cmd == "start":
            cmd_start(track_dir)
        elif cmd == "validate":
            cmd_validate(track_dir)
        elif cmd == "phase-done":
            cmd_phase_done(track_dir, pos[0])
        elif cmd == "shas":
            cmd_shas(track_dir)
        elif cmd == "add-checkpoint":
            if len(pos) < 2:
                out(dict(error="Missing phase or sha argument"))
                sys.exit(1)
            cmd_add_checkpoint(track_dir, pos[0], pos[1])
        elif cmd == "finalize":
            cmd_finalize(track_dir)
        elif cmd == "process-result":
            cmd_process_result(track_dir)
        elif cmd == "init":
            cmd_init(track_dir,
                     flag(args, "--plan-structure") or "{}",
                     flag(args, "--track-id") or "track",
                     flag(args, "--type") or "feature",
                     flag(args, "--description") or "")
        else:
            print(f"Unknown command: {cmd}", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        out(dict(error=str(e)))
        sys.exit(1)


if __name__ == "__main__":
    main()
