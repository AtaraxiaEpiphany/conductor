#!/usr/bin/env bash
# SubagentStop hook: log subagent completion and inject post-processing context
# Uses asyncRewake for critical subagents to auto-recover on failure.
set -eo pipefail

INPUT=$(cat)

AGENT_TYPE=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('agent_type',''))" 2>/dev/null || echo "")
SESSION_ID=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('session_id',''))" 2>/dev/null || echo "")
LAST_MESSAGE=$(echo "$INPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('last_assistant_message','')[:500] if d.get('last_assistant_message') else '')" 2>/dev/null || echo "")

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
LOG_DIR="${CLAUDE_PLUGIN_DATA:-$PLUGIN_ROOT/.data}/logs"
mkdir -p "$LOG_DIR"

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Log lifecycle event
echo "${TIMESTAMP} session=${SESSION_ID} agent=${AGENT_TYPE} event=subagent_stop" >> "${LOG_DIR}/subagent-lifecycle.log"

# Detect failure patterns
FAILURE_PATTERNS=(
    "error"
    "failed"
    "exception"
    "traceback"
    "timed out"
    "API error"
)

IS_FAILURE=false
for pattern in "${FAILURE_PATTERNS[@]}"; do
    if [[ "${LAST_MESSAGE,,}" =~ ${pattern,,} ]]; then
        IS_FAILURE=true
        echo "${TIMESTAMP} session=${SESSION_ID} agent=${AGENT_TYPE} failure_detected pattern=${pattern}" >> "${LOG_DIR}/subagent-failures.log"
        break
    fi
done

# For critical subagents with asyncRewake: exit 2 to wake session on failure
# Exit 2 signals asyncRewake to wake Claude for recovery
if [[ "$IS_FAILURE" == "true" ]]; then
    case "$AGENT_TYPE" in
        task-executor|explorer|phase-checker)
            echo "{\"hookSpecificOutput\": {\"hookEventName\": \"SubagentStop\", \"additionalContext\": \"[Conductor] ${AGENT_TYPE} reported failure. Auto-recovery triggered. Run /conductor:implement to continue.\"}}" >&2
            exit 2
            ;;
    esac
fi

echo '{}'
exit 0
