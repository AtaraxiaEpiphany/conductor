{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conductor Track State",
  "description": "Authoritative state file for a Conductor track. Managed exclusively by the track-state CLI.",
  "type": "object",
  "required": ["track_id", "type", "status", "description", "current_phase_index", "current_task_index", "updated_at", "phases"],
  "additionalProperties": false,
  "properties": {
    "track_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+_\\d{8}$",
      "description": "Format: shortname_YYYYMMDD"
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bugfix", "chore", "docs"]
    },
    "status": {
      "type": "string",
      "enum": ["new", "in_progress", "completed", "archived", "blocked", "cancelled"]
    },
    "execution_mode": {
      "type": "string",
      "enum": ["interactive", "continuous"],
      "description": "Execution mode for implement skill. Interactive pauses at checkpoints; continuous auto-proceeds."
    },
    "workflow_shape": {
      "type": "string",
      "description": "The declared workflow topology this track runs (third-axis registry). 'default' = planner→executor→checker. Resolved via workflow_shapes.resolve_shape; absent/unknown → 'default' (fail-open). A shape_violation is surfaced when a dispatch agent is off-topology."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when track was archived. Only present when status is 'archived'."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "current_phase_index": {
      "type": "integer",
      "minimum": 0
    },
    "current_task_index": {
      "type": "integer",
      "minimum": 0
    },
    "current_subtask_index": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["name", "status", "tasks"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "status": { "$ref": "#/$defs/task_status" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["name", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "status": { "$ref": "#/$defs/task_status" },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-task override of the global MAX_RETRIES. Absent → use the global default."
        },
        "last_failure_summary": { "type": "string" },
        "skip_analysis": { "type": "string" },
        "defer_reason": { "type": "string" },
        "task_type": {
          "type": "string",
          "description": "Derived task type from the plan.md name tag (e.g. 'docs', 'chore', 'refactor', or 'default' when no tag). A typed mirror of extract_tags; the task name string remains the authoritative source (reconcile/sync key on the name, not this field). Regenerated by init-from-plan --force when the name's tag changes."
        },
        "evidence": {
          "type": "object",
          "description": "Verification evidence captured on task completion.",
          "additionalProperties": false,
          "properties": {
            "coverage_pct": { "type": ["number", "null"] },
            "tc_coverage": { "type": "string" },
            "deviations": { "type": "integer", "minimum": 0 }
          }
        },
        "subtasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task_status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed", "skipped", "deferred", "blocked", "cancelled"]
    }
  }
}
